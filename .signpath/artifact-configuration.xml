<?xml version="1.0" encoding="utf-8"?>
<!-- Configuração "windows-installers" do projeto no SignPath (colada no painel, não lida pelo CI).
     O artifact do GitHub é um zip com nsis/*.exe e msi/*.msi, como o release.yml envia. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="nsis/*-setup.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
    <msi-file-set>
      <include path="msi/*.msi" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </msi-file-set>
  </zip-file>
</artifact-configuration>
